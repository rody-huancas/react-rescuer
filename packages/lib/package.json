{
  "name": "react-rescuer",
  "version": "0.1.4",
  "description": "React error boundaries with automatic recovery, observability, breadcrumbs, and DevOverlay",
  "license": "MIT",
  "author": {
    "name": "Rody Huancas",
    "url": "https://github.com/rody-huancas"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/rody-huancas/react-rescuer.git",
    "directory": "packages/lib"
  },
  "bugs": {
    "url": "https://github.com/rody-huancas/react-rescuer/issues"
  },
  "homepage": "https://github.com/rody-huancas/react-rescuer#readme",
  "engines": {
    "node": ">=18.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "files": [
    "dist"
  ],
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs",
      "default": "./dist/index.js"
    },
    "./hooks": {
      "types": "./dist/hooks.d.ts",
      "import": "./dist/hooks.js",
      "require": "./dist/hooks.cjs",
      "default": "./dist/hooks.js"
    },
    "./hoc": {
      "types": "./dist/hoc.d.ts",
      "import": "./dist/hoc.js",
      "require": "./dist/hoc.cjs",
      "default": "./dist/hoc.js"
    },
    "./observability": {
      "types": "./dist/observability.d.ts",
      "import": "./dist/observability.js",
      "require": "./dist/observability.cjs",
      "default": "./dist/observability.js"
    },
    "./recovery": {
      "types": "./dist/recovery.d.ts",
      "import": "./dist/recovery.js",
      "require": "./dist/recovery.cjs",
      "default": "./dist/recovery.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "import": "./dist/testing.js",
      "require": "./dist/testing.cjs",
      "default": "./dist/testing.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "peerDependencies": {
    "react": ">=18.0.0",
    "react-dom": ">=18.0.0"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.0.0",
    "@testing-library/react": "^16.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "jsdom": "^25.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsup": "^8.0.0",
    "typescript": "^5.5.0",
    "vitest": "^2.0.0"
  },
  "keywords": [
    "react",
    "error-boundary",
    "error-boundaries",
    "errors",
    "error-handling",
    "recovery",
    "retry",
    "backoff",
    "observability",
    "breadcrumbs",
    "fingerprint",
    "monitoring",
    "devoverlay",
    "fallback",
    "typescript",
    "react18"
  ],
  "sideEffects": false,
  "funding": {
    "type": "github",
    "url": "https://github.com/sponsors/rody-huancas"
  }
}
